# ==============================================================================
# HACKATHON SGU 2026 - MATPHO REPOSITORY GITIGNORE (ROOT LEVEL)
# Bảo vệ thông tin bí mật (Secrets), dọn sạch cache, và tối ưu dung lượng Git
# Quy tắc chung cho cả repo. Quy tắc riêng của từng phần nằm trong thư mục của phần đó.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BẢO MẬT & CHÌA KHÓA DỊCH VỤ (SECRETS, CREDENTIALS, KEYS & PROPERTIES)
# ------------------------------------------------------------------------------
# Chặn các file môi trường ở TẤT CẢ mọi cấp thư mục
.env
.env.*
*.env
!.env.example
!**/.env.example

# Firebase client config: chia sẻ nội bộ, tuyệt đối không đưa lên public repo
**/google-services.json
**/GoogleService-Info.plist

# Docker local overrides
docker-compose.override.yml
**/docker-compose.override.yml
*.override.yml

# Service account JSON & Private keys
firebase-service-account*.json
*service-account*.json
*service_account*.json
*service*account*.json
**/credentials/*.json
credentials/*.json
!**/credentials/.gitkeep
!credentials/.gitkeep
!**/credentials/firebase_client/**
!credentials/firebase_client/**

# Tokens & các file cấu hình bí mật JSON / YAML
token.json
tokens/
*secret*.json
*secrets*.json
*secret*.yaml
*secret*.yml
private*.json

# Chứng chỉ số, keys, keystores, Android/iOS properties
**/local.properties
**/key.properties
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.keystore
*.jks

# ------------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU NỘI BỘ & RUNTIME STATE
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.rdb
redis_data/
data/
*.ipc

# ------------------------------------------------------------------------------
# 3. MARKDOWN FILES, AI AGENTS, LOCAL TOOLS & DOCS
# ------------------------------------------------------------------------------
# Chặn toàn bộ tất cả các file Markdown (.md) trên toàn bộ repo, NGOẠI TRỪ README.md
*.md
**/*.md
!README.md
!**/README.md
!readme.md
!**/readme.md

# Chặn script thực thi cục bộ Windows (.bat, .ps1)
*.bat
*.ps1

# Ngoại lệ: Cho phép script run.ps1 của FireWatchAI chạy kiểm tra SHA-256
!EdgeAI-MatPho/FireWatchAI/run.ps1

# Chặn công cụ test RTSP nội bộ
tool_test_rtsp/
**/tool_test_rtsp/

# Chặn công cụ test FCM nội bộ
tool_test_fcm/
**/tool_test_fcm/

# Chặn Postman collections & environments cục bộ
postman/
**/postman/

# Chặn toàn bộ thư mục kỹ năng và cấu hình AI agent cục bộ
.agents/
skills-lock.json
/CLAUDE.md
CLAUDE.local.md
.claude/
.ua/
.understand-anything/

# Chặn kho tài liệu kiến thức nội bộ
docs/
/docs/

