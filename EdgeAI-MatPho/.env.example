# ==============================================================================
# EdgeAI-MatPho: On-Premise Edge Environment Configuration
# ==============================================================================

# Unique hardware device identifier at site
EDGE_DEVICE_ID=edg_local_01

# Cloud Backend URLs (Control Plane & Alert Webhooks)
CLOUD_BACKEND_URL=https://api.matpho.vn
CLOUD_BACKEND_WS_URL=wss://api.matpho.vn/api/v1/internal/edge/ws

# Internal Secret Key for Outbound Authenticated Communication
INTERNAL_API_SECRET_KEY=secure_internal_key_for_ai_and_worker_communication

# Local MediaMTX Endpoints (Docker Internal Network)
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554

# Local SQLite Cache Path (WAL mode)
SQLITE_DB_PATH=/app/data/edge.db

# Cloudflare Zero Trust Named Tunnel Token (for Public HLS Playback)
CLOUDFLARE_TUNNEL_TOKEN=

# AI Service Settings (Phase 4.5)
AI_CAMERA_IDS=cam_mock
AI_SAMPLING_FPS=1.0
AI_CONFIDENCE_THRESHOLD=0.60
ALERT_COOLDOWN_SECONDS=30.0

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
