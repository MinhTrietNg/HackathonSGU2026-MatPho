# ==============================================================================
# Mắt Phố - EdgeAI Environment Configuration (.env.example)
# Copy this file to `.env` before running `docker compose up -d --build`
# ==============================================================================

# 1. Edge Identity & Cloud Connection
EDGE_DEVICE_ID=edg_local_01
CLOUD_BACKEND_API_URL=http://host.docker.internal:8000
CLOUD_BACKEND_WS_URL=ws://host.docker.internal:8000/api/v1/internal/edge/ws
INTERNAL_API_SECRET_KEY=secure_internal_key_for_ai_and_worker_communication

# 2. Local MediaMTX & Standardized Stream Routing (Input RTSP -> Output HLS live/{cam_id})
MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554
MEDIAMTX_HLS_URL=http://localhost:8888
PATH_SOURCE_TEMPLATE=source/{cam_id}
PATH_APP_TEMPLATE=live/{cam_id}
PATH_AI_TEMPLATE=ai/{cam_id}
STREAM_PATH_TEMPLATE=live/{cam_id}

# 3. Stream Worker Settings
ENABLE_AI_BRANCH=false
DECODER_STREAMS=[{"cam_id": "cam_01", "source_url": "rtsp://mediamtx:8554/mock/cam_test"}]
RTSP_TRANSPORT=tcp
SUBSTREAM_TARGET_FPS=3.0
SUBSTREAM_MAX_EDGE=640
SUBSTREAM_CRF=26
DECODE_THREADS=2
ENCODE_THREADS=2

# 4. AI Skeleton Settings (1 Input RTSP -> 1 Output Webhook)
AI_CAMERA_STREAMS=[{"cam_id": "cam_01"}]
AI_TARGET_FPS=3.0
AI_CONFIDENCE_THRESHOLD=0.50
AI_ALERT_COOLDOWN_S=15.0
AI_MODEL_WEIGHTS_PATH=/app/weights/best.pt

# 5. Logging & Storage
EDGE_SQLITE_PATH=/app/data/edge_local.db
LOG_LEVEL=INFO
