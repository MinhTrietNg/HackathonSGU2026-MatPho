# ==============================================================================
# Mắt Phố - EdgeAI Autonomous Node Environment Template (.env.example)
# Bản mẫu cấu hình cho cụm EdgeAI (MediaMTX, Edge Backend & FireWatch AI)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Edge Identity & Cloud Connection
# ------------------------------------------------------------------------------
EDGE_DEVICE_ID=edg_local_01
CLOUD_BACKEND_URL=https://matpho-backend-afpzgiifaq-as.a.run.app
CLOUD_BACKEND_API_URL=https://matpho-backend-afpzgiifaq-as.a.run.app
CLOUD_BACKEND_WS_URL=wss://matpho-backend-afpzgiifaq-as.a.run.app/api/v1/internal/edge/ws
INTERNAL_API_SECRET_KEY=secure_internal_key_for_ai_and_worker_communication

# ------------------------------------------------------------------------------
# 2. Local MediaMTX & Standardized Stream Routing (Input RTSP -> Output HLS live/{cam_id})
# ------------------------------------------------------------------------------
MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554
MEDIAMTX_HLS_URL=http://localhost:8888
PATH_SOURCE_TEMPLATE=source/{cam_id}
PATH_APP_TEMPLATE=live/{cam_id}
PATH_AI_TEMPLATE=ai/{cam_id}
STREAM_PATH_TEMPLATE=live/{cam_id}
# URL HLS công khai điện thoại mở được (https://...trycloudflare.com, domain riêng). Để trống
# thì edge-backend tự đọc URL tunnel từ tunnel.log; không có tunnel thì dùng EDGE_LAN_IP.
EDGE_PUBLIC_HLS_URL=
# IP LAN của máy chạy cụm Edge (demo trong cùng Wi-Fi, không tunnel). run_edge.sh và
# run_eag_ai.bat tự dò khi để trống. Cloud sẽ trả http://<IP>:8888/live/<cam_id>/index.m3u8.
EDGE_LAN_IP=

# ------------------------------------------------------------------------------
# 3. Stream Worker Engine Settings
# ------------------------------------------------------------------------------
ENABLE_AI_BRANCH=false
DECODER_STREAMS=[{"cam_id": "cam_01", "source_url": "rtsp://mediamtx:8554/mock/cam_test"}]
RTSP_TRANSPORT=tcp
SUBSTREAM_TARGET_FPS=3.0
SUBSTREAM_MAX_EDGE=640
SUBSTREAM_CRF=26
SUBSTREAM_QUEUE_SIZE=2
DECODE_THREADS=2
ENCODE_THREADS=2
STREAM_MODE=always_on
LIVE_IDLE_TTL_S=60.0

# ------------------------------------------------------------------------------
# 4. FireWatchAI (FireWatchAI/docs/van_hanh.md mục 11)
# ------------------------------------------------------------------------------
# Camera chạy ngay khi khởi động; có thể thêm "context": "HAM" | "TRET" | "NGOAI".
# Nhịp, ngưỡng, cooldown và trọng số lấy từ FireWatchAI/config.yaml và
# FireWatchAI/models/README.md: AI_TARGET_FPS, AI_CONFIDENCE_THRESHOLD,
# AI_ALERT_COOLDOWN_S, AI_MODEL_WEIGHTS_PATH bị FireWatchAI bỏ qua (có ghi log).
AI_CAMERA_STREAMS=[{"cam_id": "cam_01"}]
AI_CAMERA_IDS=cam_01
AI_TARGET_FPS=3.0
AI_CONFIDENCE_THRESHOLD=0.50
AI_ALERT_COOLDOWN_S=15.0
AI_MODEL_WEIGHTS_PATH=/app/weights/best.pt
# Xác minh VLM (Gemini). Trống thì VLM tắt, mọi cảnh báo cần người xác thực.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 5. Local Storage & Logging
# ------------------------------------------------------------------------------
EDGE_SQLITE_PATH=/app/data/edge_local.db
LOG_LEVEL=INFO
