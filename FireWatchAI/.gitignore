# Môi trường
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/

# Bí mật
.env

# Dữ liệu và kết quả chạy (nặng, không commit). Ngoại lệ: bảng thuộc tính, nguồn
# train và manifest SHA-256 của bộ test T1-dev (nhẹ, phải có lịch sử để đối chiếu băm)
data/*
!data/catalog/
data/catalog/*
!data/catalog/t1_dev_v1.1_*
events/
runs/
result/
Data-hackathon/   # bản giải nén rar cũ, nếu có

# Trọng số model (tải lại hoặc nhận từ người train)
models/*.pt
models/*.onnx
*.pt
*.onnx

# Báo cáo sinh tự động giữ lại, nhưng không giữ cache hình tạm
reports/_tmp/
reports/**/matpho_fire_*/samples_*.jpg
# Ảnh ghép batch train/val của Ultralytics chứa khung clip có bản quyền
reports/train_*/*_batch*.jpg

# Model tải về để khảo sát: chỉ giữ tài liệu (README, KET_QUA.md, nguon.json),
# không commit trọng số / file gốc (có model cấm phân phối lại)
scout/*/goc/
