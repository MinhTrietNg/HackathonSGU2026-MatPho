# Docker build ignore for MatPho Backend
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
tests/
postman/
scripts/

# Ignore local env and credentials
.env
.env.*
*.cloudrun.yaml
*.ps1
*.bat
credentials/*.json
!credentials/.gitkeep

# Ignore OS files
.DS_Store
Thumbs.db
.git
.gitignore
