# ==============================================================================
# Mắt Phố - Backend Environment Configuration (Cloud Core Stack)
# ==============================================================================

# Server Environment
ENVIRONMENT=development
LOG_LEVEL=info

# FastAPI Core Settings
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change_this_to_a_secure_random_key_in_production
INTERNAL_API_SECRET_KEY=secure_internal_key_for_ai_and_worker_communication

# Firebase Configuration
# Host path to Firebase Service Account JSON (read-only mounted into container)
FIREBASE_CREDENTIALS_PATH=./credentials/firebase-service-account.json
FIREBASE_PROJECT_ID=matpho-c7e77
FIREBASE_STORAGE_BUCKET=matpho-c7e77.firebasestorage.app
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# MediaMTX Streaming Server Settings
# Inside Docker Compose network:
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554
MEDIAMTX_WHEP_URL=http://mediamtx:8889
# Public / Host URL where Flutter Mobile App connects for HLS playback:
MEDIAMTX_HOST=http://localhost:8888
HLS_PATH_TEMPLATE=live/{cam_id}

# Redis Cache & Debounce State Engine
# Inside Docker Compose network:
REDIS_URL=redis://redis:6379/0
