# ==============================================================================
# Mắt Phố - Backend Environment Template (.env.example)
# Bản mẫu cấu hình cho Backend FastAPI Core Gateway, Redis & MediaMTX
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8000

# ------------------------------------------------------------------------------
# 2. Security & Authentication Secrets
# ------------------------------------------------------------------------------
SECRET_KEY=change_this_to_a_secure_random_key_in_production
INTERNAL_API_SECRET_KEY=secure_internal_key_for_ai_and_worker_communication
JWT_SECRET_KEY=matpho_jwt_secret_for_emergency_tokens_12345

# ------------------------------------------------------------------------------
# 3. Google Cloud & Firebase BaaS
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=matpho-c7e77
FIREBASE_STORAGE_BUCKET=matpho-c7e77.firebasestorage.app
FIREBASE_CREDENTIALS_PATH=./credentials/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# ------------------------------------------------------------------------------
# 4. MediaMTX Streaming Server Settings
# ------------------------------------------------------------------------------
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554
MEDIAMTX_WHEP_URL=http://mediamtx:8889
MEDIAMTX_HOST=https://stream.matpho.vn
HLS_PATH_TEMPLATE=live/{cam_id}

# ------------------------------------------------------------------------------
# 5. Redis Cache & Two-Tier Escalation State Engine
# ------------------------------------------------------------------------------
REDIS_URL=rediss://default:gQAAAAAAAvH2AAIgcDI3Mzg5YjhlYzNhODc0MTJhOWIyNDg2NmIwNmJmMWI0YQ@integral-osprey-193014.upstash.io:6379

# ------------------------------------------------------------------------------
# 6. CORS & Network Policies
# ------------------------------------------------------------------------------
CORS_ORIGINS=["*"]
