# ==============================================================================
# Mắt Phố Mobile App - Environment Configuration
# ==============================================================================

# Backend chạy local (không dùng Google Cloud Run nữa).
# Chế độ:
#   'local' : kết nối backend local ở LOCAL_BASE_URL (khuyến nghị)
#   'auto'  : thử 127.0.0.1 và 10.0.2.2 (emulator) trước khi chạy app
ENV=local

# Android Emulator: 10.0.2.2. Điện thoại thật: IP Wi-Fi LAN của máy chạy backend
# (ví dụ 192.168.1.20), hoặc URL tunnel :8000 của RUN_MATPHO_SYSTEM.bat (https/wss).
LOCAL_BASE_URL=http://10.0.2.2:8000/api/v1
LOCAL_WS_URL=ws://10.0.2.2:8000/api/v1/ws

# Ghi đè trực tiếp (bỏ trống nếu dùng LOCAL_*). Đặt cả hai cùng lúc.
API_BASE_URL=
WS_URL=
