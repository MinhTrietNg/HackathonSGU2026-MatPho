# ==============================================================================
# Mắt Phố Mobile App - Environment Configuration
# ==============================================================================

# Chế độ: 
#   'auto'  : Tự động dò xem máy tính Local có chạy không, nếu không thì dùng Cloud
#   'local' : Luôn kết nối máy tính cá nhân
#   'prod'  : Luôn kết nối Google Cloud Production
ENV=prod

# 1. Cấu hình máy tính Local (Android Emulator 10.0.2.2 hoặc IP Wi-Fi LAN)
LOCAL_BASE_URL=http://10.0.2.2:8000/api/v1
LOCAL_WS_URL=ws://10.0.2.2:8000/api/v1/ws

# 2. Cấu hình Production (Google Cloud Run)
PROD_BASE_URL=https://matpho-backend-afpzgiifaq-as.a.run.app/api/v1
PROD_WS_URL=wss://matpho-backend-afpzgiifaq-as.a.run.app/api/v1/ws

# 3. Ghi đè trực tiếp lên Google Cloud Run
API_BASE_URL=https://matpho-backend-afpzgiifaq-as.a.run.app/api/v1
WS_URL=wss://matpho-backend-afpzgiifaq-as.a.run.app/api/v1/ws
